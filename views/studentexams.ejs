<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>DASHMIN - Exam Details</title>
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />

  <link href="/img/favicon.ico" rel="icon" />
  <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet" />
  <link href="/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet" />
  <link href="/lib/tempusdominus/css/tempusdominus-bootstrap-4.min.css" rel="stylesheet" />
  <link href="/css/bootstrap.min.css" rel="stylesheet" />
  <link href="/css/style.css" rel="stylesheet" />
  <link href="/css/custom-style.css" rel="stylesheet" />

  <style>
    .content {
      padding-top: 80px;
    }
  </style>
</head>

<body>
  <%- include('partials/student_header', { studentId }) %>
    <div class="container-xxl position-relative bg-white d-flex p-0">
      <%- include('partials/student_sidebar', { studentId, activePage}) %>

    <!-- Content -->
    <div class="content w-100">
      <div class="container-fluid px-6 py-4">
        <h2 class="mb-4">Exam Details</h2>

        <% if (exams.length === 0) { %>
          <p>No exams scheduled at the moment.</p>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-bordered">
              <thead class="table-dark">
                <tr>
                  <th>Course</th>
                  <th>Exam Type</th>
                  <th>Date</th>
                  <th>Start Time</th>
                  <th>End Time</th>
                  <th>Location</th>
                </tr>
              </thead>
              <tbody>
                <% exams.forEach(exam => { %>
                  <tr>
                    <td><%= exam.course_name %></td>
                    <td><%= exam.exam_type %></td>
                    <td><%= exam.date %></td>
                    <td><%= exam.start_time %></td>
                    <td><%= exam.end_time %></td>
                    <td><%= exam.location %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- JS -->
  <%- include('partials/student_scripts') %>
</body>

</html>
