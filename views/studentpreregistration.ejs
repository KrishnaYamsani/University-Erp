<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>DASHMIN - Pre-Registration</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">

    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
    <link href="/lib/tempusdominus/css/tempusdominus-bootstrap-4.min.css" rel="stylesheet" />
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/custom-style.css" rel="stylesheet">

    <style>
        .content {
            padding-top: 80px;
        }
        .preregistration-form {
            background: #fff;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0,0,0,0.05);
        }
        .preregistration-form h2 {
            margin-bottom: 20px;
        }
        .form-group label {
            font-weight: 500;
        }
        .courses-table th, .courses-table td {
            vertical-align: middle;
        }
    </style>
</head>

<body>
    <%- include('partials/student_header', { studentId }) %>
    <div class="container-xxl position-relative bg-white d-flex p-0">
      <%- include('partials/student_sidebar', { studentId, activePage}) %>

        <!-- Content -->
        <div class="content w-100">
            <div class="container-fluid px-6 py-4">
                <div class="preregistration-form">
                    <h2>Pre-Registration Form</h2>
                    <form action="/student/preregistration/studentId/<%= studentId %>" method="POST">
                        <h5 class="mb-3">Choose your preferences</h5>
                        <table class="table table-bordered courses-table">
                            <thead class="table-light">
                                <tr>
                                    <th>Course</th>
                                    <th>Faculty</th>
                                    <th>Preference (1,2,3...)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% offerings.forEach(course => { %>
                                    <tr>
                                        <td><%= course.course_name %></td>
                                        <td><%= course.faculty_name %></td>
                                        <td>
                                            <input type="number" min="1" max="<%= offerings.length %>"
                                                name="<%= course.offering_id %>"
                                                class="form-control" required>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                        <button type="submit" class="btn btn-primary">Submit Preferences</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- JS -->
    <%- include('partials/student_scripts') %>
</body>
</html>
