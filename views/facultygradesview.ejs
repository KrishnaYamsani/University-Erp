<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>DASHMIN - View Grades</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="keywords">
    <meta content="" name="description">

    <!-- Favicon -->
    <link href="img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
    <link href="lib/tempusdominus/css/tempusdominus-bootstrap-4.min.css" rel="stylesheet" />

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">
    
    <!-- Custom Stylesheet -->
    <link href="/custom-style.css" rel="stylesheet">
    
    <style>
        .greeting-message {
            margin-top: 60px; /* Adjust the margin top as needed */
        }
    </style>
</head>
<body>
    <!-- Topbar Start -->
    <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom fixed-top px-4 py-2">
        <div class="container-fluid">
            <div class="navbar-nav ms-auto">
                <div class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <img src="/img/user.jpg" alt="Profile" class="rounded-circle" style="width: 40px; height: 40px;">
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                        <li><a class="dropdown-item" href="#">Profile</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="/logout">Logout</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>
    <!-- Topbar End -->

    <div class="container-xxl position-relative bg-white d-flex p-0">
       <!-- Sidebar Start -->
    <div class="sidebar pe-4 pb-3">
        <nav class="navbar bg-light navbar-light">
            <a href="/faculty/facultyprofileinfo/facultyid/<%= user.id %>" class="navbar-brand mx-4 mb-3">
                <h3 class="text-primary"><i class="fa fa-hashtag me-2"></i>DASHMIN</h3>
            </a>
            <div class="d-flex align-items-center ms-4 mb-4">
                <div class="position-relative">
                    <img class="rounded-circle" src="/img/user.jpg" alt="Profile" style="width: 40px; height: 40px;">
                    <div class="bg-success rounded-circle border border-2 border-white position-absolute end-0 bottom-0 p-1"></div>
                </div>
                <div class="ms-3">
                    <h6 class="mb-0">Welcome</h6>
                    <span>Faculty</span>
                </div>
            </div>
            <div class="navbar-nav w-100">
                <a href="/faculty/facultyprofileinfo/facultyid/<%= user.id %>" class="nav-item nav-link"><i class="fa fa-user me-2"></i>Profile</a>
                <a href="/faculty/courses/faculty_id/<%= user.id %>" class="nav-item nav-link active"><i class="fa fa-book me-2"></i>Courses</a>
                <a href="/faculty/allfacultydetails/facultyid/<%= user.id %>" class="nav-item nav-link"><i class="fa fa-users me-2"></i>Faculty Directory</a>
                <% if (isFacultyAdvisor) { %>
                    <a href="/facultyadvisor/advisestudents/facultyid/<%= user.id %>" class="nav-item nav-link"><i class="fa fa-user-tie me-2"></i>Advisory Panel</a>
                    <a href="/facultyadvisor/releasegrades/facultyid/<%= user.id %>" class="nav-item nav-link"><i class="fa fa-bullhorn me-2"></i>Release Grades</a>
                <% } else { %>
                    <a class="nav-item nav-link disabled" href="#"><i class="fa fa-user-tie me-2"></i>Advisory Panel</a>
                    <a class="nav-item nav-link disabled" href="#"><i class="fa fa-bullhorn me-2"></i>Release Grades</a>
                <% } %>
            </div>
        </nav>
    </div>
    <!-- Sidebar End -->

        <!-- Content Start -->
        <div class="content w-100">
            <div class="container-fluid px-6 py-4">
                <h3>View Grades</h3>
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Student ID</th>
                                <th>Student Name</th>
                                <th>Grade</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (grades.length > 0) { %>
                                <% grades.forEach(grade => { %>
                                    <tr>
                                        <td><%= grade.student_id %></td>
                                        <td><%= grade.student_name %></td>
                                        <td><%= grade.grade %></td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="3" class="text-center">No grades available for this course.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!-- Content End -->
    </div>

    <!-- JS -->
    <script src="/lib/jquery/jquery.min.js"></script>
    <script src="/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
