<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>DASHMIN - Attendance Details</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">

    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
    <link href="/lib/tempusdominus/css/tempusdominus-bootstrap-4.min.css" rel="stylesheet" />
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/custom-style.css" rel="stylesheet">

    <style>
        .content {
            padding-top: 80px;
        }
    </style>
</head>
<body>
    <!-- Top Bar Start -->
    <nav
      class="navbar navbar-expand-lg navbar-light bg-light border-bottom border-2 border-gray px-4 py-2 fixed-top"
    >
      <div class="container-fluid">
        <div class="navbar-nav ms-auto">
          <div class="nav-item dropdown">
            <a
              class="nav-link dropdown-toggle"
              href="#"
              id="navbarDropdown"
              role="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            >
              <img
                src="/img/user.jpg"
                alt="Profile"
                class="rounded-circle"
                style="width: 40px; height: 40px"
              />
            </a>
            <ul
              class="dropdown-menu dropdown-menu-end"
              aria-labelledby="navbarDropdown"
            >
              <li><a class="dropdown-item" href="/student/profileinfo/studentId/<%= studentId %>">Profile</a></li>
              <li><hr class="dropdown-divider" /></li>
              <li><a class="dropdown-item" href="/logout">Logout</a></li>
            </ul>
          </div>
        </div>
      </div>
    </nav>
    <%- include('partials/student_header', { studentId }) %>
    <div class="container-xxl position-relative bg-white d-flex p-0">
      <%- include('partials/student_sidebar', { studentId, activePage}) %>

        <!-- Content -->
        <div class="content w-100">
            <div class="container-fluid px-6 py-4">
                <h2 class="mb-4">Attendance Details</h2>
                <% if (attendance.length === 0) { %>
                    <p>No attendance records found.</p>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead class="table-dark">
                                <tr>
                                    <th>Course</th>
                                    <th>Classes Attended</th>
                                    <th>Total Classes</th>
                                    <th>Percentage</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% attendance.forEach(detail => { %>
                                    <tr>
                                        <td><%= detail.course_name %></td>
                                        <td><%= detail.classes_attended %></td>
                                        <td><%= detail.total_classes %></td>
                                        <td>
                                            <% if (detail.total_classes > 0) { %>
                                                <%= Math.round((detail.classes_attended * 100) / detail.total_classes) %>%
                                            <% } else { %>
                                                0%
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <%- include('partials/student_scripts') %>
</body>
</html>
