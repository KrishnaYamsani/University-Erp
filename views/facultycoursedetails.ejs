<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>DASHMIN - Faculty Course Details</title>

    <link href="/img/favicon.ico" rel="icon">
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/custom-style.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">

    <style>
        .content { 
            padding-top: 100px; /* space for fixed navbar */
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 20px;
        }
        .table td, .table th { vertical-align: middle; }
        .action-buttons a {
            margin-right: 8px;
            margin-bottom: 5px;
        }
    </style>
</head>

<body>


    <%- include('partials/faculty_header', { user }) %>
<!-- Layout -->
<div class="container-xxl position-relative bg-white d-flex p-0">

    <%- include('partials/faculty_sidebar', { user, isFacultyAdvisor, activePage }) %>

  

    <!-- Content Start -->
    <div class="content w-100">
        <div class="container-fluid px-6 py-4">

            <div class="d-flex justify-content-between mb-4">
                <h2>Courses You Are Offering</h2>
                <a href="/faculty/addcourse/facultyid/<%= user.id %>" class="btn btn-success">
                    <i class="fa fa-plus"></i> Add New Course
                </a>
            </div>

            <% if (courseDetails && courseDetails.length > 0) { %>
                <h4>Main Faculty Courses</h4>
                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Course Name</th>
                            <th>Credits</th>
                            <th>Contact Hours</th>
                            <th>Co-Faculties</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% courseDetails.forEach(course => { %>
                            <tr>
                                <td><%= course.course_name %></td>
                                <td><%= course.credits %></td>
                                <td><%= course.contact_hours %></td>
                                <td>
                                    <% if (course.co_faculties.length > 0) { %>
                                        <ul>
                                            <% course.co_faculties.forEach(cof => { %>
                                                <li>
                                                    <%= cof.name %>
                                                    <a href="/faculty/removeco_faculty/course_offering_id/<%= course.offering_id %>/faculty_id/<%= cof.id %>" class="btn btn-sm btn-danger ms-1">Remove</a>
                                                </li>
                                            <% }); %>
                                        </ul>
                                    <% } else { %>
                                        <span class="text-muted">No Co-Faculties</span>
                                    <% } %>
                                </td>
                                <td class="action-buttons">
                                    <a href="/faculty/coursestudents/attendance/course_offering_id/<%= course.offering_id %>" class="btn btn-sm btn-secondary">View Attendance</a>
                                    <a href="/faculty/coursestudents/giveattendance/course_offering_id/<%= course.offering_id %>" class="btn btn-sm btn-info">Mark Attendance</a>
                                    <a href="/faculty/coursestudents/grade/course_offering_id/<%= course.offering_id %>" class="btn btn-sm btn-secondary">View Grades</a>
                                    <a href="/faculty/coursestudents/givegrade/course_offering_id/<%= course.offering_id %>" class="btn btn-sm btn-info">Assign Grades</a>
                                    <a href="/faculty/editcourse/course_offering_id/<%= course.offering_id %>" class="btn btn-sm btn-warning">Edit Course</a>
                                    <a href="/faculty/setgrading/course_offering_id/<%= course.offering_id %>" class="btn btn-sm btn-primary">Grading/Attendance Policy</a>
                                    <a href="/faculty/assigncofaculty/course_offering_id/<%= course.offering_id %>" class="btn btn-sm btn-dark">Assign Co-Faculty</a>
                                    <a href="/faculty/deletecourse/course_offering_id/<%= course.offering_id %>" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this course offering?');"> Delete </a>
                                    <a href="/faculty/createpreregistration/course_offering_id/<%= course.offering_id %>" class="btn btn-sm btn-primary">Start Pre-Registration</a>
                                    <a href="/faculty/preregistrationstatus/course_offering_id/<%= course.offering_id %>" class="btn btn-sm btn-info">View Pre-Registration</a>
                                    <a href="/faculty/examschedule/course_offering_id/<%= course.offering_id %>" class="btn btn-sm btn-secondary">Exam Schedule</a>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } %>

            <% if (coFacultyCourses && coFacultyCourses.length > 0) { %>
                <h4 class="mt-5">Courses Where You Are Co-Faculty</h4>
                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Course Name</th>
                            <th>Credits</th>
                            <th>Contact Hours</th>
                            <th>Main Faculty</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% coFacultyCourses.forEach(course => { %>
                            <tr>
                                <td><%= course.course_name %></td>
                                <td><%= course.credits %></td>
                                <td><%= course.contact_hours %></td>
                                <td><%= course.main_faculty_name %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } %>

        </div>
    </div>
    <!-- Content End -->

</div>

<!-- JS -->
<%- include('partials/student_scripts') %>

</body>
</html>
