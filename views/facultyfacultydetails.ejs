<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Faculty Directory - DASHMIN</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    
    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
    <link href="/lib/tempusdominus/css/tempusdominus-bootstrap-4.min.css" rel="stylesheet" />

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/custom-style.css" rel="stylesheet">
    
    <style>
        .greeting-message {
            margin-top: 60px;
        }

        .content {
            padding-top: 80px; 
        }

        .faculty-directory-section {
            background-color: #ffffff;
            border-radius: 10px;
            padding: 30px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.05);
            font-family: 'Heebo', sans-serif;
        }

        .faculty-directory-section h4 {
            font-weight: 600;
            margin-bottom: 20px;
            color: #495057;
        }

        .faculty-directory-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 16px;
        }

        .faculty-directory-table th, .faculty-directory-table td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        .faculty-directory-table th {
            background-color: #f8f9fa;
            color: #495057;
        }

        .faculty-directory-table td {
            color: #6c757d;
        }

        .faculty-directory-table tr:hover {
            background-color: #f1f1f1;
        }
    </style>
</head>
<body>
    <!-- Top Bar Start -->
    <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom border-2 border-gray px-4 py-2 fixed-top">
        <div class="container-fluid">
            <div class="navbar-nav ms-auto">
                <div class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <img src="/img/user.jpg" alt="Profile" class="rounded-circle" style="width: 40px; height: 40px;">
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                        <li><a class="dropdown-item" href="#">Profile</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="/logout">Logout</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>
    <!-- Top Bar End -->

    <div class="container-xxl position-relative bg-white d-flex p-0">
        <!-- Sidebar Start -->
        <div class="sidebar pe-4 pb-3">
            <nav class="navbar bg-light navbar-light">
                <a href="/faculty/facultyprofileinfo/facultyid/<%= user.id %>" class="navbar-brand mx-4 mb-3">
                    <h3 class="text-primary"><i class="fa fa-hashtag me-2"></i>DASHMIN</h3>
                </a>
                <div class="d-flex align-items-center ms-4 mb-4">
                    <div class="position-relative">
                        <img class="rounded-circle" src="/img/user.jpg" alt="Profile" style="width: 40px; height: 40px;">
                        <div class="bg-success rounded-circle border border-2 border-white position-absolute end-0 bottom-0 p-1"></div>
                    </div>
                    <div class="ms-3">
                        <h6 class="mb-0">Welcome</h6>
                        <span>Faculty</span>
                    </div>
                </div>
                <div class="navbar-nav w-100">
                    <a href="/faculty/facultyprofileinfo/facultyid/<%= user.id %>" class="nav-item nav-link"><i class="fa fa-user me-2"></i>Profile</a>
                    <a href="/faculty/courses/faculty_id/<%= user.id %>" class="nav-item nav-link"><i class="fa fa-book me-2"></i>Courses</a>
                    <a href="/faculty/allfacultydetails/facultyid/<%= user.id %>" class="nav-item nav-link active"><i class="fa fa-users me-2"></i>Faculty Directory</a>
                    <a href="/facultyadvisor/advisestudents/facultyid/<%= user.id %>" 
                       class="nav-item nav-link <%= isFacultyAdvisor ? '' : 'disabled-link' %>">
                      <i class="fa fa-user-tie me-2"></i>Advisory Panel
                    </a>
                    <a href="/facultyadvisor/releasegrades/facultyid/<%= user.id %>" 
                       class="nav-item nav-link <%= isFacultyAdvisor ? '' : 'disabled-link' %>">
                      <i class="fa fa-bullhorn me-2"></i>Release Grades
                    </a>
                </div>
            </nav>
        </div>
        <!-- Sidebar End -->

        <!-- Content Start -->
        <div class="content">
            <div class="container-fluid px-6 py-4">
                <div class="row">
                    <div class="col-xl-12 mb-4">
                        <div class="faculty-directory-section">
                            <h4>Faculty Directory</h4>
                            <table class="faculty-directory-table">
                                <thead>
                                    <tr>
                                        <th>Faculty ID</th>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Phone</th>
                                        <th>Office Number</th>
                                        <th>Department ID</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% facultyDetails.forEach(faculty => { %>
                                        <tr>
                                            <td><%= faculty.id %></td>
                                            <td><%= faculty.name %></td>
                                            <td><%= faculty.mail_id %></td>
                                            <td><%= faculty.phone_number %></td>
                                            <td><%= faculty.office_number %></td>
                                            <td><%= faculty.dept_id %></td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Content End -->
    </div>

    <!-- JavaScript Libraries -->
    <script src="/lib/jquery/jquery.min.js"></script>
    <script src="/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/lib/owlcarousel/owl.carousel.min.js"></script>
    <script src="/lib/tempusdominus/js/moment.min.js"></script>
    <script src="/lib/tempusdominus/js/moment-timezone.min.js"></script>
    <script src="/lib/tempusdominus/js/tempusdominus-bootstrap-4.min.js"></script>

    <!-- Template Javascript -->
    <script src="/js/main.js"></script>
</body>
</html>
