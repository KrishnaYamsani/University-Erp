<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>DASHMIN - Student Dashboard</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">

    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
    <link href="/lib/tempusdominus/css/tempusdominus-bootstrap-4.min.css" rel="stylesheet" />

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">

    <!-- Custom Stylesheet -->
    <link href="/css/custom-style.css" rel="stylesheet">

    <style>
        .greeting-message {
            margin-top: 60px;
        }

        
        .content {
            padding-top: 80px; 
        }

        .student-details-section {
            background-color: #ffffff;
            border-radius: 10px;
            padding: 30px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.05);
            font-family: 'Heebo', sans-serif;
        }

        .student-details-section h4 {
            font-weight: 600;
            margin-bottom: 20px;
            color: #495057;
        }

        .student-details-section ul {
            list-style-type: none;
            padding: 0;
        }

        .student-details-section ul li {
            padding: 8px 0;
            font-size: 16px;
            color: #6c757d;
        }

        .student-details-section ul li strong {
            color: #495057;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <%- include('partials/student_header', { studentId }) %>
    <div class="container-xxl position-relative bg-white d-flex p-0">
      <%- include('partials/student_sidebar', { studentId, activePage}) %>

        <!-- Content Start -->
        <div class="content">
            <div class="container-fluid px-6 py-4">
                <div class="row">
                    <div class="col-xl-12 mb-4">
                        <div class="student-details-section">
                            <h4>Student Details</h4>
                            <ul>
                                <li><strong>Student ID:</strong> <%= student.roll_no %></li>
                                <li><strong>Name:</strong> <%= student.name %></li>
                                <li><strong>Gender:</strong> <%= student.gender %></li>
                                <li><strong>Email:</strong> <%= student.mail_id %></li>
                                <li><strong>Address:</strong> <%= student.address %></li>
                                <li><strong>Phone number:</strong> <%= student.phone_number %></li>
                                <li><strong>DoB:</strong> <%= student.dob %></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Content End -->
    </div>

    <%- include('partials/student_scripts') %>
</body>
</html>
